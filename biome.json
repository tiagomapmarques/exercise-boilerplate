{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*",
      "!**/Thumbs.db",
      "!**/.DS_Store",
      "!**/node_modules",
      "!**/node-compile-cache",
      "!**/.pnpm-store",
      "!**/licenses.*json",
      "!**/.tanstack",
      "!**/*.gen.*",
      "!**/.tmp",
      "!**/*.tsbuildinfo",
      "!**/dist",
      "!**/coverage",
      "!**/reports",
      "!**/.vitest",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.idea",
      "!**/.vscode",
      "!**/.zed",
      "!**/.env",
      "!**/DEVELOPER.md",
      "!**/TODO"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "domains": {
      "playwright": "all",
      "project": "all",
      "react": "all",
      "test": "all",
      "types": "all"
    },
    "rules": {
      "a11y": {
        "noNoninteractiveElementInteractions": "warn"
      },
      "complexity": {
        "noDivRegex": "warn",
        "noExcessiveCognitiveComplexity": "warn",
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 100,
            "skipBlankLines": true
          }
        },
        "noExcessiveNestedCallbacks": "warn",
        "noExcessiveNestedTestSuites": "warn",
        "noExcessiveSelectorClasses": "warn",
        "noExtraBooleanCast": "warn",
        "noFlatMapIdentity": "warn",
        "noForEach": "warn",
        "noImplicitCoercions": "warn",
        "noPlaywrightUselessAwait": "warn",
        "noRedundantDefaultExport": "warn",
        "noUnnecessaryTemplateExpression": "warn",
        "noUselessCatch": "warn",
        "noUselessCatchBinding": "warn",
        "noUselessConstructor": "warn",
        "noUselessContinue": "warn",
        "noUselessEmptyExport": "warn",
        "noUselessEscapeInRegex": "warn",
        "noUselessFragments": "warn",
        "noUselessLabel": "warn",
        "noUselessLoneBlockStatements": "warn",
        "noUselessRename": "warn",
        "noUselessReturn": "warn",
        "noUselessStringConcat": "warn",
        "noUselessStringRaw": "warn",
        "noUselessSwitchCase": "warn",
        "noUselessTernary": "warn",
        "noUselessThisAlias": "warn",
        "noUselessTypeConstraint": "warn",
        "noUselessUndefined": "warn",
        "noUselessUndefinedInitialization": "warn",
        "noVoid": "warn",
        "useArrayFind": "warn",
        "useArraySome": "warn",
        "useFlatMap": "warn",
        "useIndexOf": "warn",
        "useLiteralKeys": "warn",
        "useMaxParams": "warn",
        "useRegexpTest": "warn",
        "useSimplifiedLogicExpression": "off",
        "useWhile": "warn"
      },
      "correctness": {
        "noGlobalDirnameFilename": "warn",
        "noNodejsModules": "warn",
        "noProcessGlobal": "off",
        "noReactPropAssignments": "warn",
        "noRestrictedElements": "warn",
        "noUndeclaredVariables": "error",
        "noUnresolvedImports": "off",
        "noUnusedInstantiation": "error",
        "useImportExtensions": "off",
        "useJsonImportAttributes": "warn",
        "useParseIntRadix": "warn",
        "useSingleJsDocAsterisk": "warn",
        "useUniqueElementIds": {
          "level": "error",
          "options": {
            "excludedComponents": ["Trans", "Plural"]
          }
        }
      },
      "performance": {
        "noAwaitInLoops": "warn",
        "noBarrelFile": "off",
        "noDelete": "warn",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "warn",
        "noReExportAll": "off",
        "useTopLevelRegex": "warn"
      },
      "security": {
        "noSecrets": "warn",
        "useIframeSandbox": "error"
      },
      "style": {
        "noCommonJs": "warn",
        "noContinue": "warn",
        "noDefaultExport": "warn",
        "noDoneCallback": "warn",
        "noEnum": "warn",
        "noExcessiveClassesPerFile": "warn",
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": {
            "maxLines": 600,
            "skipBlankLines": true
          }
        },
        "noExportedImports": "warn",
        "noHexColors": "warn",
        "noImplicitBoolean": "off",
        "noIncrementDecrement": "warn",
        "noInferrableTypes": "warn",
        "noInlineStyles": "warn",
        "noJsxLiterals": "warn",
        "noMagicNumbers": "warn",
        "noMultiAssign": "warn",
        "noMultilineString": "warn",
        "noNamespace": "warn",
        "noNegationElse": "warn",
        "noNestedTernary": "warn",
        "noParameterAssign": "warn",
        "noParameterProperties": "warn",
        "noPlaywrightElementHandle": "warn",
        "noPlaywrightEval": "warn",
        "noPlaywrightWaitForSelector": "warn",
        "noProcessEnv": "warn",
        "noRestrictedGlobals": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "node:console": {},
              "console": {},
              "@lingui/core": {
                "allowImportNames": [
                  "I18n",
                  "MessageDescriptor",
                  "Messages",
                  "setupI18n"
                ]
              },
              "@testing-library/react": {},
              "vitest": {},
              "vitest/browser": {}
            },
            "patterns": [
              {
                "group": ["@/*/*/*"]
              },
              {
                "group": ["../**"]
              },
              {
                "group": ["~/**"]
              }
            ]
          }
        },
        "noRestrictedTypes": "warn",
        "noRootType": "warn",
        "noShoutyConstants": "warn",
        "noSubstr": "warn",
        "noTernary": "off",
        "noTopLevelLiterals": "warn",
        "noUnusedTemplateLiteral": "warn",
        "noUselessElse": "warn",
        "noValueAtRule": "warn",
        "noYodaExpression": "warn",
        "useArrayLiterals": "warn",
        "useAsConstAssertion": "warn",
        "useAtIndex": "warn",
        "useBlockStatements": "warn",
        "useCollapsedElseIf": "warn",
        "useCollapsedIf": "warn",
        "useConsistentArrayType": "warn",
        "useConsistentArrowReturn": "off",
        "useConsistentBuiltinInstantiation": "warn",
        "useConsistentCurlyBraces": "warn",
        "useConsistentEnumValueType": "warn",
        "useConsistentGraphqlDescriptions": "warn",
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": {
            "accessibility": "explicit"
          }
        },
        "useConsistentMethodSignatures": "warn",
        "useConsistentObjectDefinitions": "warn",
        "useConsistentTestIt": "warn",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useDefaultParameterLast": "warn",
        "useDefaultSwitchClause": "warn",
        "useDestructuring": "warn",
        "useDomQuerySelector": "warn",
        "useEnumInitializers": "warn",
        "useErrorCause": "warn",
        "useExplicitLengthCheck": "warn",
        "useExponentiationOperator": "warn",
        "useExportsLast": "off",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "useForOf": "warn",
        "useFragmentSyntax": "warn",
        "useGlobalThis": "warn",
        "useGraphqlNamingConvention": "warn",
        "useGroupedAccessorPairs": "warn",
        "useImportsFirst": "warn",
        "useInputName": "warn",
        "useLoneExecutableDefinition": "warn",
        "useNamedCaptureGroup": "warn",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false
          }
        },
        "useNodeAssertStrict": "warn",
        "useNodejsImportProtocol": "warn",
        "useNumberNamespace": "warn",
        "useNumericSeparators": "warn",
        "useObjectSpread": "warn",
        "useReactFunctionComponents": "warn",
        "useReadonlyClassProperties": "warn",
        "useReduceTypeParameter": "warn",
        "useSelfClosingElements": "warn",
        "useShorthandAssign": "warn",
        "useShorthandFunctionType": "warn",
        "useSingleVarDeclarator": "warn",
        "useSpreadOverApply": "warn",
        "useSymbolDescription": "warn",
        "useTemplate": "warn",
        "useTestHooksInOrder": "warn",
        "useTestHooksOnTop": "warn",
        "useThisInClassMethods": "warn",
        "useThrowNewError": "warn",
        "useThrowOnlyError": "warn",
        "useTrimStartEnd": "warn",
        "useUnicodeRegex": "warn",
        "useUnifiedTypeSignatures": "warn",
        "useVarsOnTop": "warn"
      },
      "suspicious": {
        "noAlert": "warn",
        "noBitwiseOperators": "warn",
        "noConsole": "warn",
        "noConstantBinaryExpressions": "warn",
        "noDuplicateDependencies": "warn",
        "noDuplicateFields": "warn",
        "noDuplicateGraphqlOperationName": "warn",
        "noDuplicateProperties": "off",
        "noDuplicateSelectors": "warn",
        "noEmptyBlockStatements": "warn",
        "noEmptyObjectKeys": "warn",
        "noEmptySource": "warn",
        "noEqualsToNull": "warn",
        "noEvolvingTypes": "warn",
        "noForIn": "warn",
        "noLoopFunc": "warn",
        "noMisplacedAssertion": "warn",
        "noNestedPromises": "warn",
        "noParametersOnlyUsedInRecursion": "warn",
        "noQuickfixBiome": "warn",
        "noReturnAssign": "error",
        "noShadow": "warn",
        "noUnassignedVariables": "warn",
        "noUnknownAtRules": "off",
        "noUnusedExpressions": "warn",
        "noVar": "warn",
        "useAwait": "warn",
        "useBaseline": "warn",
        "useDeprecatedDate": "warn",
        "useErrorMessage": "warn",
        "useGuardForIn": "warn",
        "useNumberToFixedDigitsArgument": "warn",
        "useRequiredScripts": "warn",
        "useStaticResponseMethods": "warn",
        "useStrictMode": "warn"
      },
      "nursery": {
        "noBaseToString": "warn",
        "noBufferConstructor": "warn",
        "noBunModules": "warn",
        "noDanglingUnderscore": "warn",
        "noDisabledAttribute": "warn",
        "noDynamicDelete": "warn",
        "noDynamicRequire": "warn",
        "noExcessiveNestedBlocks": "warn",
        "noExcessiveSelectorComplexity": "warn",
        "noExcessiveStatementsPerFunction": {
          "level": "warn",
          "options": {
            "max": 30
          }
        },
        "noExtendNative": "warn",
        "noFloatingPromises": "warn",
        "noInvalidFileInputAccept": "error",
        "noInvalidPropertyInitValue": "warn",
        "noInvalidThis": "warn",
        "noJsRestrictedProperties": {
          "level": "warn",
          "options": {
            "entries": [
              {
                "object": "vi",
                "property": "spyOn",
                "message": "Wrap the original with `vi.fn()` instead."
              }
            ]
          }
        },
        "noMagicArrayFlatDepth": "warn",
        "noMapSpread": "off",
        "noMeaninglessVoidOperator": "warn",
        "noMisleadingReturnType": "warn",
        "noMismatchedMapKey": "warn",
        "noMissingScssInterpolation": "error",
        "noMisusedPromises": "warn",
        "noMisusedSpread": "warn",
        "noNegatedArrayPredicate": "off",
        "noNegationInEqualityCheck": "warn",
        "noNestedSwitch": "warn",
        "noNestedTemplateLiterals": "warn",
        "noNewArray": "warn",
        "noNewRequire": "warn",
        "noNonScalableViewport": "error",
        "noNull": "off",
        "noObjectConstructor": "warn",
        "noObsoleteTags": "warn",
        "noPlaywrightNthMethods": "warn",
        "noPlaywrightUnsafeReferences": "error",
        "noProcessExit": "warn",
        "noPromiseExecutorReturn": "warn",
        "noPseudoElementInFunctionalPseudoClass": "error",
        "noReactDirectStateMutation": "error",
        "noReactObjectTypeAsDefaultProp": "error",
        "noRestrictedDependencies": "warn",
        "noReturnInFinally": "warn",
        "noScssNullComparison": "warn",
        "noSelfImport": "error",
        "noSelfNestedLayer": "warn",
        "noSharedBranchCode": "warn",
        "noShortTimeValues": "warn",
        "noSyncMethods": "off",
        "noThisOutsideOfClass": "warn",
        "noUndeclaredClasses": "warn",
        "noUndeclaredCustomProperties": "off",
        "noUnmodifiedLoopCondition": "warn",
        "noUnnecessaryStringTrim": "warn",
        "noUnreadableForOfExpression": "warn",
        "noUnreadableIife": "warn",
        "noUnresolvedDefaultImport": "error",
        "noUnsafePlusOperands": "warn",
        "noUnsafeReturn": "warn",
        "noUnsafeTypeAssertion": "error",
        "noUnsafeUnaryMinus": "warn",
        "noUnusedClasses": "off",
        "noUselessAwait": "warn",
        "noUselessCall": "warn",
        "noUselessLengthCheck": "warn",
        "noUselessParameterPropertyAssignment": "warn",
        "noUselessQualifier": "warn",
        "noUselessRecursion": "warn",
        "noUselessSpread": "warn",
        "noUselessTypeAssertion": "warn",
        "noUselessTypeConversion": "warn",
        "noZeroFractions": "warn",
        "noZeroLengthUnit": "warn",
        "useAccessorPairs": "warn",
        "useAtomicUpdates": "warn",
        "useAwaitThenable": "warn",
        "useBetterDomTraversing": "warn",
        "useBlockStatementOverIife": "warn",
        "useCalledWith": "warn",
        "useCatchErrorName": "warn",
        "useConsistentBooleanName": "warn",
        "useConsistentFontWeightNotation": "warn",
        "useConsistentFunctionStyle": "warn",
        "useConsistentHeadingLevel": "warn",
        "useConsistentJsonFileRead": "warn",
        "useConsistentLightnessNotation": "warn",
        "useConsistentTupleLabels": "warn",
        "useConsistentUnicodeBom": "warn",
        "useControlLabel": "error",
        "useDisposables": "warn",
        "useExhaustiveSwitchCases": "warn",
        "useExpectToContain": "warn",
        "useExpectToHaveBeenCalled": "warn",
        "useExpectToHaveBeenCalledTimes": "warn",
        "useExplicitReturnType": "off",
        "useExplicitType": "off",
        "useFencedCodeLanguage": "warn",
        "useIncludes": "warn",
        "useIteratorZip": "warn",
        "useLayeredStyles": "off",
        "useLogicalProperties": "warn",
        "useLowercaseTestTitle": "warn",
        "useMatchingFunctionName": "warn",
        "useNamedFunction": "warn",
        "useNamedLayer": "warn",
        "useNullishCoalescing": "warn",
        "usePackageJsonCpu": "off",
        "usePackageJsonEngines": "warn",
        "usePromiseRejectErrors": "warn",
        "useReactCompiler": "warn",
        "useReactFunctionComponentDefinition": {
          "level": "warn",
          "options": {
            "namedComponents": "arrowFunction"
          }
        },
        "useReactNamingConvention": "warn",
        "useRegexpExec": "warn",
        "useSimplifiedBooleanReturn": "warn",
        "useSingleTopLevelHeading": "warn",
        "useSpyOn": "off",
        "useStrictBooleanExpressions": "off",
        "useStringStartsEndsWith": "warn",
        "useTanstackQueryStableQueryClient": "error",
        "useTopLevelHeading": "warn",
        "useTopLevelRequire": "warn",
        "useValidNamespaceImports": "error",
        "useValidTestTitle": "off",
        "useWhileLoopCondition": "warn"
      }
    }
  },
  "javascript": {
    "globals": ["vi", "expectTypeOf"],
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              "react",
              "react-dom",
              "react-dom/client",
              ":PACKAGE:",
              ":BLANK_LINE:",
              "@/testing",
              "@/testing/*",
              "@/providers/*",
              "@/pages/*",
              "@/components/*",
              "@/services/*",
              "@/utilities/*",
              "@/locales/*",
              "~/*",
              ":ALIAS:",
              ":BLANK_LINE:",
              [":PATH:", "!**/*.css"],
              "**/*.css"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["bin/**/*", "**/*.config.*", "server.mjs"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "nursery": {
            "noProcessExit": "off",
            "noUnsafeReturn": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/dev-tools/**/*"],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": "off"
          }
        }
      }
    },
    {
      "includes": ["src/testing/**/*", "**/*.test.*"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "correctness": {
            "useUniqueElementIds": "off",
            "noComponentHookFactories": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "style": {
            "noExcessiveClassesPerFile": "off",
            "noJsxLiterals": "off",
            "noMagicNumbers": "off",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:console": {},
                  "console": {},
                  "@lingui/core": {
                    "allowImportNames": [
                      "I18n",
                      "MessageDescriptor",
                      "Messages",
                      "setupI18n"
                    ]
                  },
                  "@testing-library/react": {},
                  "vitest": {},
                  "vitest/browser": {}
                },
                "patterns": [
                  {
                    "group": ["../**"]
                  },
                  {
                    "group": ["~/**"]
                  }
                ]
              }
            },
            "useNamedCaptureGroup": "off"
          }
        }
      }
    },
    {
      "includes": ["e2e/**/*"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:console": {},
                  "console": {},
                  "@lingui/core": {
                    "allowImportNames": [
                      "I18n",
                      "MessageDescriptor",
                      "Messages",
                      "setupI18n"
                    ]
                  },
                  "@testing-library/react": {},
                  "vitest": {},
                  "vitest/browser": {}
                },
                "patterns": [
                  {
                    "group": ["@/**"]
                  },
                  {
                    "group": ["../**"]
                  }
                ]
              }
            },
            "useConsistentTestIt": {
              "level": "error",
              "options": {
                "function": "test",
                "withinDescribe": "test"
              }
            }
          }
        }
      }
    }
  ]
}
