{
  "name": "exercise-boilerplate",
  "description": "Seed project for a modern React app",
  "version": "0.16.0",
  "license": "MIT",
  "engines": {
    "node": "^24.22.3 || ^26.13.1",
    "pnpm": "^12.21.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm"
    }
  },
  "scripts": {
    "postinstall": "playwright install && pnpm run licenses && node ./bin/env-file.mjs && tsr generate",
    "start": "vite",
    "build": "vite build",
    "serve": "node --env-file-if-exists=.env ./server.mjs",
    "build:watch": "(pnpm build --watch &) && pnpm serve",
    "i18n": "lingui extract --clean && lingui compile --typescript --strict",
    "test": "vitest --run --bail=1",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write --error-on-warnings",
    "lint:rewrite": "biome migrate --write && node ./bin/biome-file.mjs",
    "licenses": "pnpm licenses ls --prod --json > licenses.prod.json && pnpm licenses ls --json > licenses.json",
    "dependencies": "taze major --interactive --write --install",
    "dependencies:update": "taze minor --no-include-locked --write --install && pnpm lint:rewrite && pnpm dependencies:rewrite",
    "dependencies:rewrite": "node ./bin/rm.mjs node_modules ./pnpm-lock.yaml && pnpm install",
    "check": "pnpm check:project && pnpm check:runtime && pnpm check:other",
    "check:ci": "pnpm install && pnpm check:project && pnpm check:runtime && node ./bin/check-engines.mjs --offline && node ./bin/uncommitted-changes.mjs --error-on-warnings",
    "check:project": "pnpm dedupe --check && knip && dpdm --no-warning --no-tree ./**/*",
    "check:runtime": "pnpm i18n && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:e2e",
    "check:other": "node ./bin/taze-major-only.mjs && node ./bin/check-engines.mjs && node ./bin/uncommitted-changes.mjs && pnpm audit",
    "docker:build": "docker build -t exercise-boilerplate-app:$(pnpm --silent helper:version) --progress=plain .",
    "docker:run": "docker run -p 8080:8080 --rm -it --name exercise-boilerplate-app-container exercise-boilerplate-app:$(pnpm --silent helper:version)",
    "docker:ci": "pnpm docker:ci:build && pnpm docker:ci:copy && pnpm docker:ci:clean",
    "docker:ci:build": "HASH=$(pnpm --silent helper:hash) && docker build -t exercise-boilerplate-ci:$HASH -f Dockerfile.ci --progress=plain . && docker container create --name exercise-boilerplate-ci-container-$HASH exercise-boilerplate-ci:$HASH",
    "docker:ci:copy": "HASH=$(pnpm --silent helper:hash) && docker cp exercise-boilerplate-ci-container-$HASH:/reports .",
    "docker:ci:clean": "HASH=$(pnpm --silent helper:hash) && docker rm exercise-boilerplate-ci-container-$HASH && docker image rm exercise-boilerplate-ci:$HASH",
    "helper:version": "node -p \"require('./package.json').version\"",
    "helper:hash": "git rev-parse --short HEAD"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.11",
    "@lingui/cli": "^6.12.0",
    "@lingui/core": "^6.12.0",
    "@lingui/detect-locale": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@mantine/core": "^9.8.0",
    "@mantine/nprogress": "^9.8.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.169.0",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitejs/plugin-react": "^6.3.0",
    "country-flag-icons": "^1.6.20",
    "fastify": "^5.12.8",
    "lucide-react": "^1.73.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/router-cli": "^1.168.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "dpdm": "^4.3.0",
    "knip": "^6.45.1",
    "playwright": "^1.65.1",
    "taze": "^21.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
